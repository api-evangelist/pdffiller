{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDFfiller REST Applications Tools API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.pdffiller.com/v2/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Tools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Merge PDF documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdffiller.com/v2/tools/merge",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Merges multiple PDF documents into a single PDF file."
        }
      ]
    }
  ],
  "bundled": true
}