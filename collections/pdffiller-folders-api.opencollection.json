{
  "opencollection": "1.0.0",
  "info": {
    "name": "PDFfiller REST Applications Folders API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.pdffiller.com/v2/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdffiller.com/v2/folders",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to sort results by"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
          },
          "docs": "Returns a list of all document folders."
        },
        {
          "info": {
            "name": "Create a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pdffiller.com/v2/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new document folder."
        },
        {
          "info": {
            "name": "Get folder by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pdffiller.com/v2/folders/:folder_id",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the folder"
              }
            ]
          },
          "docs": "Returns information about a specific folder."
        },
        {
          "info": {
            "name": "Update a folder",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pdffiller.com/v2/folders/:folder_id",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the folder"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing folder."
        },
        {
          "info": {
            "name": "Delete a folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pdffiller.com/v2/folders/:folder_id",
            "params": [
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the folder"
              }
            ]
          },
          "docs": "Removes the specified folder."
        }
      ]
    }
  ],
  "bundled": true
}